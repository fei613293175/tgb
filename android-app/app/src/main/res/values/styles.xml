<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tuiguangbao" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/noto_sans_sc_regular</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/tgb_background</item>
        <item name="android:navigationBarColor">@color/tgb_surface</item>
        <item name="android:windowBackground">@color/tgb_background</item>
        <item name="android:colorAccent">@color/tgb_primary</item>
    </style>

    <style name="Theme.Tuiguangbao.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tgb_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Tuiguangbao</item>
    </style>
</resources>
